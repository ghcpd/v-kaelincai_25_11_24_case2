{
  "test_scenarios": [
    {
      "scenario_id": "baseline_normal_fare",
      "description": "Standard ride with normal fare breakdown - baseline client without includeFareBreakdown",
      "ride_id": "ride_001",
      "include_fare_breakdown": false,
      "network_latency_ms": 50,
      "expected_output": {
        "status": 200,
        "schema_contains_breakdown": false,
        "totalFare_validation": true,
        "expected_fields": ["rideId", "totalFare", "currency", "distance", "duration"],
        "expected_fare_total": 25.50
      },
      "edge_case_flags": [],
      "performance_baseline": {
        "num_backend_calls": 2,
        "expected_latency_ms_min": 90,
        "expected_latency_ms_max": 150
      }
    },
    {
      "scenario_id": "optimized_normal_fare",
      "description": "Standard ride with optimized endpoint returning fare breakdown in single call",
      "ride_id": "ride_001",
      "include_fare_breakdown": true,
      "network_latency_ms": 50,
      "expected_output": {
        "status": 200,
        "schema_contains_breakdown": true,
        "totalFare_validation": true,
        "breakdown_present": true,
        "breakdown_items_count": 4,
        "expected_fare_total": 25.50,
        "expected_fields": ["rideId", "totalFare", "currency", "distance", "duration", "fareBreakdown"]
      },
      "edge_case_flags": [],
      "performance_optimized": {
        "num_backend_calls": 1,
        "expected_latency_ms_min": 40,
        "expected_latency_ms_max": 100,
        "latency_reduction_percent": 50
      }
    },
    {
      "scenario_id": "weak_network_baseline",
      "description": "Baseline approach on weak network - 2 sequential calls with high latency",
      "ride_id": "ride_002",
      "include_fare_breakdown": false,
      "network_latency_ms": 1500,
      "expected_output": {
        "status": 200,
        "schema_contains_breakdown": false,
        "totalFare_validation": true
      },
      "edge_case_flags": ["high_latency", "network_stress"],
      "performance_baseline": {
        "num_backend_calls": 2,
        "expected_latency_ms_min": 2900,
        "expected_latency_ms_max": 3500
      }
    },
    {
      "scenario_id": "weak_network_optimized",
      "description": "Optimized approach on weak network - single call eliminates overhead",
      "ride_id": "ride_002",
      "include_fare_breakdown": true,
      "network_latency_ms": 1500,
      "expected_output": {
        "status": 200,
        "schema_contains_breakdown": true,
        "breakdown_present": true
      },
      "edge_case_flags": ["high_latency", "network_stress"],
      "performance_optimized": {
        "num_backend_calls": 1,
        "expected_latency_ms_min": 1450,
        "expected_latency_ms_max": 2000
      }
    },
    {
      "scenario_id": "malformed_ride_id",
      "description": "Request with malformed ride ID - invalid characters, SQL injection attempt",
      "ride_id": "ride_'; DROP TABLE rides; --",
      "include_fare_breakdown": false,
      "network_latency_ms": 50,
      "expected_output": {
        "status": 400,
        "error_code": "INVALID_RIDE_ID",
        "error_message": "Ride ID contains invalid characters"
      },
      "edge_case_flags": ["security", "input_validation", "sql_injection_attempt"]
    },
    {
      "scenario_id": "hidden_vulnerability_label_injection",
      "description": "Fare breakdown with HTML/script injection in label field",
      "ride_id": "ride_003",
      "include_fare_breakdown": true,
      "network_latency_ms": 50,
      "fare_data_override": {
        "labels_contain_xss": "<img src=x onerror='alert(1)'>",
        "labels_contain_html": "<script>alert('xss')</script>"
      },
      "expected_output": {
        "status": 200,
        "schema_contains_breakdown": true,
        "breakdown_labels_sanitized": true,
        "no_executable_content": true
      },
      "edge_case_flags": ["security", "xss_prevention", "output_sanitization"]
    },
    {
      "scenario_id": "non_string_fare_fields",
      "description": "Fare breakdown with non-string types in amount/label fields",
      "ride_id": "ride_004",
      "include_fare_breakdown": true,
      "network_latency_ms": 50,
      "fare_data_override": {
        "amount_as_string": "15.50",
        "amount_as_none": null,
        "label_as_int": 12345,
        "label_as_list": ["service", "fee"]
      },
      "expected_output": {
        "status": 200,
        "schema_contains_breakdown": true,
        "breakdown_type_validation": "strict",
        "all_amounts_numeric": true,
        "all_labels_strings": true
      },
      "edge_case_flags": ["type_mismatch", "robust_validation"]
    },
    {
      "scenario_id": "nested_breakdown_structures",
      "description": "Fare breakdown with nested/complex structures and unexpected types",
      "ride_id": "ride_005",
      "include_fare_breakdown": true,
      "network_latency_ms": 50,
      "fare_data_override": {
        "nested_breakdown": true,
        "deeply_nested_objects": true
      },
      "expected_output": {
        "status": 200,
        "schema_contains_breakdown": true,
        "breakdown_flattened": true,
        "unexpected_nesting_handled": true
      },
      "edge_case_flags": ["schema_flexibility", "nested_structures"]
    }
  ],
